@page "/admin/to-do-item"
@page "/admin/to-do-item/page/{CurrentPage:int}"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>To Do Item Home</PageTitle>

<h1>To Do Item Home</h1>
<h6><a href="/admin/to-do-item/add">Create New</a></h6>

<div class="container-fluid">
  <table class="table table-hover table-primary table-striped">
    <thead>
      <tr>
        <th>Actions</th>
        <th>Is Completed?</th>
        <th>Ordering</th>
        <th>To Do List</th>
        <th>Title</th>
        @* TableHeaderCodePlaceholder *@
      </tr>
    </thead>
    <tbody>
      @if (toDoItems is not null)
      {
        @foreach (var toDoItem in toDoItems)
        {
          <tr>
            <td>
              <div class="btn-group">
                <a class="btn btn-primary btn-sm btn-info" href="/admin/to-do-item/view/@toDoItem.Id" title="View">
                  <i class="bi bi-eye"></i>
                </a>
                <a class="btn btn-primary btn-sm" href="/admin/to-do-item/edit/@toDoItem.Id" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
              </div>
            </td>
            <td>
              @if (toDoItem != null && toDoItem.IsCompleted)
              {
                <span class="badge bg-success">Yes</span>
              }
              else
              {
                <span class="badge bg-warning text-dark">No</span>
              }
            </td>
            <td>@toDoItem?.Ordering</td>
            <td>@toDoItem?.ToDoList?.Title</td>
            <td>@toDoItem?.Title</td>
            @* TableRowCodePlaceholder *@
          </tr>
        }
      }
    </tbody>
  </table>

  <!-- Pagination Controls -->
  <nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
      <!-- Previous Page Button -->
      <li class="page-item @(CurrentPage <= 1 ? "disabled" : "")">
        <a class="page-link" href="/admin/to-do-item/page/@(CurrentPage - 1)" aria-label="Previous">
          <span aria-hidden="true">&laquo;</span>
        </a>
      </li>

      <!-- Page Number Buttons -->
      @for (int i = Math.Max(1, CurrentPage - 2); i <= Math.Min(TotalPages, CurrentPage + 2); i++)
      {
        <li class="page-item @(i == CurrentPage ? "active" : "")">
          <a class="page-link" href="/admin/to-do-item/page/@i">@i</a>
        </li>
      }

      <!-- Next Page Button -->
      <li class="page-item @(CurrentPage >= TotalPages ? "disabled" : "")">
        <a class="page-link" href="/admin/to-do-item/page/@(CurrentPage + 1)" aria-label="Next">
          <span aria-hidden="true">&raquo;</span>
        </a>
      </li>
    </ul>
  </nav>
  <div class="text-center">
    <small class="text-muted">Showing page @CurrentPage of @TotalPages (@TotalItems total items)</small>
  </div>
</div>

@code {
  private ICollection<ToDoItem>? toDoItems { get; set; }

  [Parameter]
  public int CurrentPage { get; set; } = 1;

  // Default items per page
  private int PageSize { get; set; } = 10;

  private int TotalItems { get; set; }
  private int TotalPages { get; set; }

  protected override async Task OnInitializedAsync()
  {
    // Ensure CurrentPage is never less than 1
    if (CurrentPage < 1)
    {
      CurrentPage = 1;
      Navigation.NavigateTo("/admin/to-do-item/page/1");
      return;
    }

    await ReloadAsync();
  }

  protected override async Task OnParametersSetAsync()
  {
    await ReloadAsync();
  }

  private async Task ReloadAsync()
  {
    using var context = DbFactory.CreateDbContext();
    var query = context.ToDoItems?.AsQueryable();

    if (query is not null)
    {
      // Count total items for pagination
      TotalItems = await query.CountAsync();

      // Calculate total pages
      TotalPages = (int)Math.Ceiling(TotalItems / (double)PageSize);

      // If current page exceeds total pages, redirect to last page
      if (CurrentPage > TotalPages && TotalPages > 0)
      {
        CurrentPage = TotalPages;
        Navigation.NavigateTo($"/admin/to-do-item/page/{CurrentPage}");
        return;
      }

      // Get paginated data
      toDoItems = await query
        .Include(x => x.ToDoList)
        @* QueryIncludeCodePlaceholder *@
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize)
        .AsNoTracking()
        .ToListAsync();
    }
    else
    {
      toDoItems = new List<ToDoItem>();
    }
  }
}
