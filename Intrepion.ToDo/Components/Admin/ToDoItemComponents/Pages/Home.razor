@page "/admin/to-do-item"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>To Do Item Home</PageTitle>

<h1>To Do Item Home</h1>
<h6><a href="/admin/movie/add">Create New</a></h6>

<InfoGrid 
  ColumnNames="columnNames" 
  ColumnTypes="columnTypes" 
  Ids="ids" 
  Info="info"
  OnPageChanged="HandlePageChanged"
  OnRowsPerPage="HandleRowsPerPageChanged"
  Page="currentPage"
  RowsPerPage="rowsPerPage"
  TotalPages="totalPages"
  UrlName="to-do-item"
>
</InfoGrid>

@code {
  private List<string> columnNames = [
    "Is Completed?",
    "Ordering",
    "To Do List",
    "Title",
    @* ColumnNamesCodePlaceholder *@
  ];
  private List<ColumnType> columnTypes = [
    ColumnType.Boolean,
    ColumnType.Integer,
    ColumnType.Text,
    ColumnType.Normalized,
    @* ColumnTypesCodePlaceholder *@
  ];
  private List<Guid>? ids;
  private List<List<string>>? info;
  private ICollection<ToDoItem>? toDoItems;
  
  // Pagination properties
  private int currentPage = 1;
  private int rowsPerPage = 10; // Default value
  private int totalPages = 1;

  protected override void OnInitialized()
  {
    // Parse the current URL to check for page and rowsPerPage parameters
    var uri = new Uri(Navigation.Uri);
    var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
    
    // Parse page parameter
    if (int.TryParse(query["page"], out int page) && page > 0)
    {
      currentPage = page;
    }
    
    // Parse rowsPerPage parameter
    if (int.TryParse(query["rowsPerPage"], out int rpp) && rpp > 0)
    {
      // Ensure rowsPerPage is one of our valid options
      rowsPerPage = rpp switch
      {
        5 or 10 or 20 or 50 => rpp,
        _ => 10 // Default to 10 for invalid values
      };
    }
  }

  protected override async Task OnParametersSetAsync()
  {
    await ReloadAsync();
  }

  private async Task HandlePageChanged(int page)
  {
    // Update URL with both page and rowsPerPage parameters
    UpdateUrlWithParameters(page, rowsPerPage);
    
    currentPage = page;
    await ReloadAsync();
  }

  private async Task HandleRowsPerPageChanged(int newRowsPerPage)
  {
    // Reset to page 1 when changing rows per page
    currentPage = 1;
    rowsPerPage = newRowsPerPage;
    
    // Update URL with both parameters
    UpdateUrlWithParameters(1, newRowsPerPage);
    
    await ReloadAsync();
  }
  
  private void UpdateUrlWithParameters(int page, int rpp)
  {
    var uriBuilder = new UriBuilder(Navigation.Uri);
    var query = System.Web.HttpUtility.ParseQueryString(uriBuilder.Query);
    
    query["page"] = page.ToString();
    query["rowsPerPage"] = rpp.ToString();
    
    uriBuilder.Query = query.ToString();
    Navigation.NavigateTo(uriBuilder.Uri.ToString(), false);
  }

  private async Task ReloadAsync()
  {
    using var context = DbFactory.CreateDbContext();
    var query = context.ToDoItems?.AsQueryable();

    if (query is not null)
    {
      var totalItems = await query.CountAsync();
      
      totalPages = (totalItems + rowsPerPage - 1) / rowsPerPage;
      
      if (currentPage > totalPages && totalPages > 0)
      {
        currentPage = totalPages;
        UpdateUrlWithParameters(currentPage, rowsPerPage);
      }
      
      // Apply pagination to query
      var pagedQuery = query
        .Include(x => x.ToDoList)
        @* QueryIncludeCodePlaceholder *@
        .AsNoTracking()
        .Skip((currentPage - 1) * rowsPerPage)
        .Take(rowsPerPage);

      // Execute query
      toDoItems = await pagedQuery.ToListAsync();

      ids = [];
      info = [];

      foreach (var toDoItem in toDoItems)
      {
        ids.Add(toDoItem.Id);

        info.Add([
          toDoItem.IsCompleted.ToString(),
          toDoItem.Ordering.ToString(),
          "" + toDoItem?.ToDoList?.Title,
          toDoItem.Title,
          @* InfoAddCodePlaceholder *@
        ]);
      }
    }
  }
}
