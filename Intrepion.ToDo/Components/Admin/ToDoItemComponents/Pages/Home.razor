@page "/admin/to-do-item"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>To Do Item Home</PageTitle>

<h1>To Do Item Home</h1>
<h6><a href="/admin/to-do-item/add">Create New</a></h6>

<div class="small text-muted mb-3">
  <i class="bi bi-info-circle me-1"></i>
  Tap on column headers to sort. To sort by multiple columns, use the "Add To Sort" buttons in the "Sort Options" section below.
</div>

<div class="container-fluid">
  <table class="table table-hover table-primary table-striped">
    <thead>
      <tr>
        <th>Actions</th>
        <th>
          <button class="btn btn-link p-0 text-decoration-none" @onclick='() => PrimarySort("IsCompleted")'>
            Is Completed?
            @GetSortIndicator("IsCompleted")
          </button>
        </th>
        <th>
          <button class="btn btn-link p-0 text-decoration-none" @onclick='() => PrimarySort("Ordering")'>
            Ordering
            @GetSortIndicator("Ordering")
          </button>
        </th>
        <th>
          <button class="btn btn-link p-0 text-decoration-none" @onclick='() => PrimarySort("ToDoListTitle")'>
            To Do List
            @GetSortIndicator("ToDoListTitle")
          </button>
        </th>
        <th>
          <button class="btn btn-link p-0 text-decoration-none" @onclick='() => PrimarySort("Title")'>
            Title
            @GetSortIndicator("Title")
          </button>
        </th>
        @* TableHeaderCodePlaceholder *@
      </tr>
    </thead>
    <tbody>
      @if (toDoItems is not null)
      {
        @foreach (var toDoItem in toDoItems)
        {
          <tr>
            <td>
              <div class="btn-group">
                <a class="btn btn-primary btn-sm btn-info" href="/admin/to-do-item/view/@toDoItem.Id" title="View">
                  <i class="bi bi-eye"></i>
                </a>
                <a class="btn btn-primary btn-sm" href="/admin/to-do-item/edit/@toDoItem.Id" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
              </div>
            </td>
            <td>
              @if (toDoItem != null && toDoItem.IsCompleted)
              {
                <span class="badge bg-success">Yes</span>
              }
              else
              {
                <span class="badge bg-warning text-dark">No</span>
              }
            </td>
            <td>@toDoItem?.Ordering</td>
            <td>@toDoItem?.ToDoList?.Title</td>
            <td>@toDoItem?.Title</td>
            @* TableRowCodePlaceholder *@
          </tr>
        }
      }
    </tbody>
  </table>

  <!-- Sort Options Section -->
  <div class="card mb-3">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0">Sort Options</h5>
    </div>
    <div class="card-body">
      <div class="row mb-2">
        <div class="col-12">
          <label class="form-label">Active sort order:</label>
          @if (sortOrders.Count > 0)
          {
            <div class="d-flex flex-wrap gap-2 mb-2">
              @for (int i = 0; i < sortOrders.Count; i++)
              {
                var sortInfo = sortOrders[i];
                var index = i;
                <div class="badge bg-info d-flex align-items-center p-2">
                  <span>@(i + 1). @GetDisplayName(sortInfo.Field) (@(sortInfo.Direction == "asc" ? "↑" : "↓"))</span>
                  <button @onclick="() => ToggleSortDirection(index)" class="btn btn-sm text-white ms-1 p-0">
                    <i class="bi bi-arrow-down-up"></i>
                  </button>
                  <button @onclick="() => RemoveSort(index)" class="btn btn-sm text-white ms-1 p-0">
                    <i class="bi bi-x"></i>
                  </button>
                  @if (i > 0)
                  {
                    <button @onclick="() => MoveSortUp(index)" class="btn btn-sm text-white ms-1 p-0">
                      <i class="bi bi-arrow-up"></i>
                    </button>
                  }
                  @if (i < sortOrders.Count - 1)
                  {
                    <button @onclick="() => MoveSortDown(index)" class="btn btn-sm text-white ms-1 p-0">
                      <i class="bi bi-arrow-down"></i>
                    </button>
                  }
                </div>
              }
            </div>
          }
          else
          {
            <div>
              <span class="text-muted">Default sorting (Title ascending)</span>
            </div>
          }
        </div>
      </div>

      <div class="row mb-2">
        <div class="col-12">
          <label class="form-label">Add column to sort:</label>
          <div class="d-flex flex-wrap gap-2">
            @foreach (var field in GetSortableFields())
            {
              @if (!sortOrders.Any(s => s.Field == field.Key))
              {
                <button @onclick="() => AddSort(field.Key)" class="btn btn-sm btn-outline-primary">
                  @field.Value <i class="bi bi-plus"></i>
                </button>
              }
            }
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-12">
          <button @onclick="ResetSort" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-counterclockwise"></i> Reset to Default Sort
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Pagination Controls -->
  <nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
      <!-- Previous Page Button -->
      <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
        <button class="page-link" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage <= 1)" aria-label="Previous">
          <span aria-hidden="true">&laquo;</span>
        </button>
      </li>

      <!-- Page Number Buttons -->
      @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
      {
        int pageNumber = i;
        <li class="page-item @(i == currentPage ? "active" : "")">
          <button class="page-link" @onclick="() => GoToPage(pageNumber)">@i</button>
        </li>
      }

      <!-- Next Page Button -->
      <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
        <button class="page-link" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage >= totalPages)" aria-label="Next">
          <span aria-hidden="true">&raquo;</span>
        </button>
      </li>
    </ul>
  </nav>
  <div class="text-center">
    <small class="text-muted">Showing page @currentPage of @totalPages (@totalItems total items)</small>
  </div>
</div>

@code {
  private ICollection<ToDoItem>? toDoItems { get; set; }
  private int currentPage = 1;
  
  // Data structure for multi-column sorting
  private List<SortInfo> sortOrders = new List<SortInfo>();
  
  // Default items per page
  private int pageSize = 10;
  private int totalItems = 0;
  private int totalPages = 0;

  // Class to store sort information
  private class SortInfo
  {
    public string Field { get; set; } = string.Empty;
    public string Direction { get; set; } = "asc";
  }

  protected override void OnInitialized()
  {
    // Subscribe to the LocationChanged event when the component is initialized
    Navigation.LocationChanged += OnLocationChanged;
  }

  // Implement IDisposable to properly unsubscribe from the event
  public void Dispose()
  {
    // Unsubscribe from the event when the component is disposed
    Navigation.LocationChanged -= OnLocationChanged;
  }

  private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
  {
    // Read the query parameters and reload data
    await ParseQueryParametersAndLoadData();
    
    // Since this is an async void method called from an event handler,
    // we need to manually trigger a UI update
    StateHasChanged();
  }

  protected override async Task OnInitializedAsync()
  {
    await ParseQueryParametersAndLoadData();
  }

  private async Task ParseQueryParametersAndLoadData()
  {
    // Parse query parameters from the current URL
    var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
    var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);

    // Get page from query parameters or default to 1
    if (int.TryParse(queryParams["page"], out int page) && page > 0)
    {
      currentPage = page;
    }
    else
    {
      currentPage = 1;
    }

    // Clear existing sort orders
    sortOrders.Clear();

    // For multi-column sort, we'll use sort0, sort1, sort2, etc. parameters
    for (int i = 0; i < 10; i++) // Maximum of 10 sort fields
    {
      string sortKey = $"sort{i}";
      string? sortValue = queryParams[sortKey];
      
      if (string.IsNullOrEmpty(sortValue))
      {
        continue;
      }
      
      string[] parts = sortValue.Split(':');
      if (parts.Length == 2)
      {
        string field = parts[0];
        string direction = parts[1].ToLower();
        
        // Only accept valid directions
        if (direction != "asc" && direction != "desc")
        {
          direction = "asc";
        }
        
        // Only add if it's a valid field
        if (IsValidSortField(field))
        {
          sortOrders.Add(new SortInfo { Field = field, Direction = direction });
        }
      }
    }

    // If no sort orders were specified, use default sorting
    if (sortOrders.Count == 0)
    {
      sortOrders.Add(new SortInfo { Field = "Title", Direction = "asc" });
    }

    await LoadDataAsync();
  }

  private bool IsValidSortField(string field)
  {
    // List of valid sortable fields
    return field switch
    {
      "IsCompleted" or "Ordering" or "ToDoListTitle" or "Title" => true,
      _ => false
    };
  }

  private Dictionary<string, string> GetSortableFields()
  {
    return new Dictionary<string, string>
    {
      { "IsCompleted", "Completion Status" },
      { "Ordering", "Order" },
      { "ToDoListTitle", "To Do List" },
      { "Title", "Title" }
      // Add more fields as needed
    };
  }

  private async Task LoadDataAsync()
  {
    using var context = DbFactory.CreateDbContext();
    var query = context.ToDoItems?.AsQueryable();

    if (query is not null)
    {
      // Include related data
      query = query.Include(x => x.ToDoList);
      @* QueryIncludeCodePlaceholder *@

      // Count total items for pagination
      totalItems = await query.CountAsync();

      // Calculate total pages
      totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);

      // If current page exceeds total pages, adjust it
      if (currentPage > totalPages && totalPages > 0)
      {
        currentPage = totalPages;
        await NavigateToCurrentStateAsync();
        return;
      }

      // Apply sorting based on parameters
      query = ApplySorting(query);

      // Get paginated data
      toDoItems = await query
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .AsNoTracking()
        .ToListAsync();
    }
    else
    {
      toDoItems = new List<ToDoItem>();
    }
  }

  private IQueryable<ToDoItem> ApplySorting(IQueryable<ToDoItem> query)
  {
    if (sortOrders.Count == 0)
    {
      // Default sorting if no sort orders specified
      return query.OrderBy(x => x.Ordering);
    }

    // Process the first sort order
    var firstSort = sortOrders[0];
    IOrderedQueryable<ToDoItem> orderedQuery = ApplyInitialSort(query, firstSort.Field, firstSort.Direction);

    // Process subsequent sort orders
    for (int i = 1; i < sortOrders.Count; i++)
    {
      var sortInfo = sortOrders[i];
      orderedQuery = ApplyThenBy(orderedQuery, sortInfo.Field, sortInfo.Direction);
    }

    return orderedQuery;
  }

  private IOrderedQueryable<ToDoItem> ApplyInitialSort(IQueryable<ToDoItem> query, string field, string direction)
  {
    return field switch
    {
      "IsCompleted" => direction == "asc" 
                      ? query.OrderBy(x => x.IsCompleted)
                      : query.OrderByDescending(x => x.IsCompleted),
      "Ordering" => direction == "asc" 
                   ? query.OrderBy(x => x.Ordering)
                   : query.OrderByDescending(x => x.Ordering),
      "ToDoListTitle" => direction == "asc" 
                        ? query.OrderBy(x => x.ToDoList.Title)
                        : query.OrderByDescending(x => x.ToDoList.Title),
      "Title" => direction == "asc" 
                ? query.OrderBy(x => x.Title)
                : query.OrderByDescending(x => x.Title),
      // Add more sort fields as needed
      _ => query.OrderBy(x => x.Ordering) // Default sorting
    };
  }

  private IOrderedQueryable<ToDoItem> ApplyThenBy(IOrderedQueryable<ToDoItem> query, string field, string direction)
  {
    return field switch
    {
      "IsCompleted" => direction == "asc" 
                      ? query.ThenBy(x => x.IsCompleted)
                      : query.ThenByDescending(x => x.IsCompleted),
      "Ordering" => direction == "asc" 
                   ? query.ThenBy(x => x.Ordering)
                   : query.ThenByDescending(x => x.Ordering),
      "ToDoListTitle" => direction == "asc" 
                        ? query.ThenBy(x => x.ToDoList.Title)
                        : query.ThenByDescending(x => x.ToDoList.Title),
      "Title" => direction == "asc" 
                ? query.ThenBy(x => x.Title)
                : query.ThenByDescending(x => x.Title),
      // Add more sort fields as needed
      _ => query.ThenBy(x => x.Ordering) // Default sorting
    };
  }

  // New method for primary sort (clicking column headers)
  private async Task PrimarySort(string field)
  {
    // Find if field already exists in sort orders
    int existingIndex = sortOrders.FindIndex(s => s.Field == field);
    
    if (existingIndex >= 0)
    {
      // If it's already the primary sort, toggle direction
      if (existingIndex == 0)
      {
        sortOrders[0].Direction = sortOrders[0].Direction == "asc" ? "desc" : "asc";
      }
      else
      {
        // If it exists but isn't primary, move to primary and set ascending
        var item = sortOrders[existingIndex];
        sortOrders.RemoveAt(existingIndex);
        item.Direction = "asc";
        sortOrders.Insert(0, item);
      }
    }
    else
    {
      // New primary sort - set as primary
      sortOrders.Insert(0, new SortInfo { Field = field, Direction = "asc" });
    }
    
    await NavigateToCurrentStateAsync();
  }

  // Method to add a field to the sort order
  private async Task AddSort(string field)
  {
    if (!sortOrders.Any(s => s.Field == field))
    {
      sortOrders.Add(new SortInfo { Field = field, Direction = "asc" });
      await NavigateToCurrentStateAsync();
    }
  }

  // Toggle the sort direction for a specific field
  private async Task ToggleSortDirection(int index)
  {
    if (index >= 0 && index < sortOrders.Count)
    {
      sortOrders[index].Direction = sortOrders[index].Direction == "asc" ? "desc" : "asc";
      await NavigateToCurrentStateAsync();
    }
  }

  // Move a sort criterion up in priority
  private async Task MoveSortUp(int index)
  {
    if (index > 0 && index < sortOrders.Count)
    {
      var temp = sortOrders[index];
      sortOrders[index] = sortOrders[index - 1];
      sortOrders[index - 1] = temp;
      await NavigateToCurrentStateAsync();
    }
  }

  // Move a sort criterion down in priority
  private async Task MoveSortDown(int index)
  {
    if (index >= 0 && index < sortOrders.Count - 1)
    {
      var temp = sortOrders[index];
      sortOrders[index] = sortOrders[index + 1];
      sortOrders[index + 1] = temp;
      await NavigateToCurrentStateAsync();
    }
  }

  private async Task RemoveSort(int index)
  {
    if (index >= 0 && index < sortOrders.Count)
    {
      sortOrders.RemoveAt(index);
      
      // If all sort orders are removed, add a default sort
      if (sortOrders.Count == 0)
      {
        sortOrders.Add(new SortInfo { Field = "Title", Direction = "asc" });
      }
      
      await NavigateToCurrentStateAsync();
    }
  }
  
  private async Task ResetSort()
  {
    sortOrders.Clear();
    sortOrders.Add(new SortInfo { Field = "Title", Direction = "asc" });
    await NavigateToCurrentStateAsync();
  }
  
  private async Task GoToPage(int page)
  {
    if (page > 0 && (page <= totalPages || totalPages == 0))
    {
      currentPage = page;
      await NavigateToCurrentStateAsync();
    }
  }
  
  private async Task NavigateToCurrentStateAsync()
  {
    // Build URL with current state
    string url = "/admin/to-do-item?page=" + currentPage;
    
    // Add sort parameters
    for (int i = 0; i < sortOrders.Count; i++)
    {
      url += $"&sort{i}={sortOrders[i].Field}:{sortOrders[i].Direction}";
    }
    
    // Navigate and reload data
    Navigation.NavigateTo(url);
    await LoadDataAsync();
    StateHasChanged();
  }
  
  private RenderFragment GetSortIndicator(string field) => builder =>
  {
    int order = -1;
    string direction = "asc";
    
    // Find if this field is in the sort orders
    for (int i = 0; i < sortOrders.Count; i++)
    {
      if (sortOrders[i].Field == field)
      {
        order = i;
        direction = sortOrders[i].Direction;
        break;
      }
    }
    
    if (order >= 0)
    {
      builder.OpenElement(0, "span");
      builder.AddAttribute(1, "class", "ms-1");
      
      // Show sort order number if multiple sorts
      if (sortOrders.Count > 1)
      {
        builder.AddContent(2, $"{order + 1} ");
      }
      
      // Show direction icon
      builder.OpenElement(3, "i");
      builder.AddAttribute(4, "class", $"bi {(direction == "asc" ? "bi-sort-up" : "bi-sort-down")}");
      builder.CloseElement(); // i
      
      builder.CloseElement(); // span
    }
  };
  
  private string GetDisplayName(string field) => field switch
  {
    "IsCompleted" => "Completion Status",
    "Ordering" => "Order",
    "ToDoListTitle" => "To Do List",
    "Title" => "Title",
    _ => field
  };
}
