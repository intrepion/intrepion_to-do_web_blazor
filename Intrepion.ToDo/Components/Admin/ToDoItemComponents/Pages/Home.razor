@page "/admin/to-do-item"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>To Do Item Home</PageTitle>

<h1>To Do Item Home</h1>
<h6><a href="/admin/movie/add">Create New</a></h6>

<InfoGrid 
  OnPageChanged="HandlePageChanged"
  OnRowsPerPage="HandleRowsPerPageChanged"
  OnSortsChanged="HandleSortsChanged"
  ColumnNames="columnNames" 
  ColumnTypes="columnTypes" 
  Ids="ids" 
  Info="info"
  Page="currentPage"
  RowsPerPage="rowsPerPage"
  Sorts="sorts"
  TotalPages="totalPages"
  UrlName="to-do-item"
>
</InfoGrid>

@code {
  private List<string> columnNames = [
    "Completed Date and Time",
    "Is Completed?",
    "Ordering",
    "To Do List",
    "Title",
    @* ColumnNamesCodePlaceholder *@
  ];
  private List<ColumnType> columnTypes = [
    ColumnType.DateTime,
    ColumnType.Boolean,
    ColumnType.Integer,
    ColumnType.Text,
    ColumnType.Normalized,
    @* ColumnTypesCodePlaceholder *@
  ];
  private ICollection<ToDoItem>? toDoItems;
  private List<Guid>? ids;
  private List<List<string>>? info;
  private int currentPage = 1;
  private int rowsPerPage = 10;
  private List<(int, bool)> sorts = [];
  private int totalPages = 1;
  private bool isNavigating = false;

  public void Dispose()
  {
    Navigation.LocationChanged -= OnLocationChanged;
  }

  private async Task HandlePageChanged(int page)
  {
    try
    {
      isNavigating = true;
      
      currentPage = page;
      
      UpdateUrlWithParameters(page, rowsPerPage, sorts);
      
      await ReloadAsync();
    }
    finally
    {
      isNavigating = false;
    }
  }

  private async Task HandleRowsPerPageChanged(int newRowsPerPage)
  {
    try
    {
      isNavigating = true;
      
      currentPage = 1;
      rowsPerPage = newRowsPerPage;
      
      UpdateUrlWithParameters(1, newRowsPerPage, sorts);
      
      await ReloadAsync();
    }
    finally
    {
      isNavigating = false;
    }
  }

  private async Task HandleSortsChanged(List<(int, bool)> newSorts)
  {
    try
    {
      isNavigating = true;

      sorts = newSorts;

      UpdateUrlWithParameters(currentPage, rowsPerPage, sorts);

      await ReloadAsync();

      StateHasChanged();
    }
    finally
    {
      isNavigating = false;
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      await ReloadAsync();
      StateHasChanged();
    }
  }

  protected override void OnInitialized()
  {
    Navigation.LocationChanged += OnLocationChanged;

    ParseUrlParameters();
  }

  private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
  {
    if (!isNavigating && e.Location.Contains("/admin/to-do-item"))
    {
      InvokeAsync(async () => {
        bool parametersChanged = ParseUrlParameters();

        StateHasChanged();

        if (parametersChanged)
        {
          await ReloadAsync();

          StateHasChanged();
        }
      });
    }
  }

  protected override async Task OnParametersSetAsync()
  {
    await ReloadAsync();
  }

  private bool ParseUrlParameters()
  {
    var uri = new Uri(Navigation.Uri);
    var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

    var oldPage = currentPage;
    var oldRowsPerPage = rowsPerPage;
    var oldSorts = new List<(int, bool)>(sorts);

    if (int.TryParse(query["page"], out int page) && page > 0)
    {
      currentPage = page;
    }
    else
    {
      currentPage = 1;
    }

    if (int.TryParse(query["rowsPerPage"], out int rpp))
    {
      rowsPerPage = rpp switch
      {
        5 or 10 or 20 or 50 => rpp,
        _ => 10
      };
    }
    else
    {
      rowsPerPage = 10;
    }

    sorts.Clear();
    var sortParams = query["sort"]?.Split(',') ?? Array.Empty<string>();

    foreach (var sortParam in sortParams)
    {
      if (string.IsNullOrEmpty(sortParam)) continue;

      var parts = sortParam.Split(':');
      if (parts.Length == 2 && 
          int.TryParse(parts[0], out int column) && 
          bool.TryParse(parts[1], out bool ascending))
      {
        sorts.Add((column, ascending));
      }
    }
    
    var changed = oldPage != currentPage || 
                 oldRowsPerPage != rowsPerPage || 
                 !Enumerable.SequenceEqual(oldSorts, sorts);
                 
    return changed;
  }

  private async Task ReloadAsync()
  {
    using var context = DbFactory.CreateDbContext();
    var query = context.ToDoItems?.AsQueryable();

    if (query is not null)
    {
      var totalItems = await query.CountAsync();
      
      totalPages = (totalItems + rowsPerPage - 1) / rowsPerPage;
      
      if (currentPage > totalPages && totalPages > 0)
      {
        currentPage = totalPages;
        UpdateUrlWithParameters(currentPage, rowsPerPage, sorts);
      }
      
      var pagedQuery = query
        .Include(x => x.ToDoList)
        @* QueryIncludeCodePlaceholder *@
        .AsNoTracking();

      if (sorts.Count > 0)
      {
        IOrderedQueryable<ToDoItem>? orderedQuery = null;

        for (int i = 0; i < sorts.Count; i++)
        {
          var (columnIndex, isAscending) = sorts[i];

          if (i == 0)
          {
            orderedQuery = ApplyInitialOrderBy(pagedQuery, columnIndex, isAscending);
          }
          else if (orderedQuery != null)
          {
            orderedQuery = ApplyThenBy(orderedQuery, columnIndex, isAscending);
          }
        }

        pagedQuery = orderedQuery ?? pagedQuery;
      }

      pagedQuery = pagedQuery
        .Skip((currentPage - 1) * rowsPerPage)
        .Take(rowsPerPage);

      toDoItems = await pagedQuery.ToListAsync();

      ids = [];
      info = [];

      foreach (var toDoItem in toDoItems)
      {
        ids.Add(toDoItem.Id);

        info.Add([
          toDoItem.CompletedDateTime.ToString(),
          toDoItem.IsCompleted.ToString(),
          toDoItem.Ordering.ToString(),
          "" + toDoItem?.ToDoList?.Title,
          toDoItem.Title,
          @* InfoAddCodePlaceholder *@
        ]);
      }
    }
  }

  private IOrderedQueryable<ToDoItem> ApplyInitialOrderBy(IQueryable<ToDoItem> query, int columnIndex, bool isAscending)
  {
    if (isAscending)
    {
      return columnIndex switch
      {
        0 => query.OrderBy(x => x.CompletedDateTime),
        1 => query.OrderBy(x => x.IsCompleted),
        2 => query.OrderBy(x => x.Ordering),
        3 => query.OrderBy(x => x.ToDoList.Title),
        4 => query.OrderBy(x => x.Title),
        @* InitialAscendingCodePlaceholder *@
        _ => query.OrderBy(x => x.Id),
      };
    }

    return columnIndex switch
    {
      0 => query.OrderByDescending(x => x.CompletedDateTime),
      1 => query.OrderByDescending(x => x.IsCompleted),
      2 => query.OrderByDescending(x => x.Ordering),
      3 => query.OrderByDescending(x => x.ToDoList.Title),
      4 => query.OrderByDescending(x => x.Title),
      @* InitialDescendingCodePlaceholder *@
      _ => query.OrderByDescending(x => x.Id),
    };
  }

  private IOrderedQueryable<ToDoItem> ApplyThenBy(IOrderedQueryable<ToDoItem> query, int columnIndex, bool isAscending)
  {
    if (isAscending)
    {
      return columnIndex switch
      {
        0 => query.ThenBy(x => x.CompletedDateTime),
        1 => query.ThenBy(x => x.IsCompleted),
        2 => query.ThenBy(x => x.Ordering),
        3 => query.ThenBy(x => x.ToDoList.Title),
        4 => query.ThenBy(x => x.Title),
        @* ThenAscendingCodePlaceholder *@
        _ => query.ThenBy(x => x.Id),
      };
    }

    return columnIndex switch
    {
      0 => query.ThenByDescending(x => x.CompletedDateTime),
      1 => query.ThenByDescending(x => x.IsCompleted),
      2 => query.ThenByDescending(x => x.Ordering),
      3 => query.ThenByDescending(x => x.ToDoList.Title),
      4 => query.ThenByDescending(x => x.Title),
      @* ThenDescendingCodePlaceholder *@
      _ => query.ThenByDescending(x => x.Id),
    };
  }

  private void UpdateUrlWithParameters(int page, int rpp, List<(int, bool)> currentSorts)
  {
    var uriBuilder = new UriBuilder(Navigation.Uri);
    var query = System.Web.HttpUtility.ParseQueryString(uriBuilder.Query);
    
    query["page"] = page.ToString();
    query["rowsPerPage"] = rpp.ToString();
    
    if (currentSorts.Count > 0)
    {
      var sortParams = string.Join(",", currentSorts.Select(s => $"{s.Item1}:{s.Item2}"));
      query["sort"] = sortParams;
    }
    else
    {
      query.Remove("sort");
    }
    
    uriBuilder.Query = query.ToString();
    Navigation.NavigateTo(uriBuilder.Uri.ToString(), false);
  }
}
