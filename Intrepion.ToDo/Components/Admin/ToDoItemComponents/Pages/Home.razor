@page "/admin/to-do-item"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>To Do Item Home</PageTitle>

<h1>To Do Item Home</h1>
<h6><a href="/admin/to-do-item/add">Create New</a></h6>

<div class="container-fluid">
  <table class="table table-hover table-primary table-striped">
    <thead>
      <tr>
        <th>Actions</th>
        <th>
          <a href="@GetSortUrl("IsCompleted")">
            Is Completed?
            @if (sortField == "IsCompleted")
            {
              <i class="bi @(sortDirection == "asc" ? "bi-sort-up" : "bi-sort-down")"></i>
            }
          </a>
        </th>
        <th>
          <a href="@GetSortUrl("Ordering")">
            Ordering
            @if (sortField == "Ordering")
            {
              <i class="bi @(sortDirection == "asc" ? "bi-sort-up" : "bi-sort-down")"></i>
            }
          </a>
        </th>
        <th>
          <a href="@GetSortUrl("ToDoListTitle")">
            To Do List
            @if (sortField == "ToDoListTitle")
            {
              <i class="bi @(sortDirection == "asc" ? "bi-sort-up" : "bi-sort-down")"></i>
            }
          </a>
        </th>
        <th>
          <a href="@GetSortUrl("Title")">
            Title
            @if (sortField == "Title")
            {
              <i class="bi @(sortDirection == "asc" ? "bi-sort-up" : "bi-sort-down")"></i>
            }
          </a>
        </th>
        @* TableHeaderCodePlaceholder *@
      </tr>
    </thead>
    <tbody>
      @if (toDoItems is not null)
      {
        @foreach (var toDoItem in toDoItems)
        {
          <tr>
            <td>
              <div class="btn-group">
                <a class="btn btn-primary btn-sm btn-info" href="/admin/to-do-item/view/@toDoItem.Id" title="View">
                  <i class="bi bi-eye"></i>
                </a>
                <a class="btn btn-primary btn-sm" href="/admin/to-do-item/edit/@toDoItem.Id" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
              </div>
            </td>
            <td>
              @if (toDoItem != null && toDoItem.IsCompleted)
              {
                <span class="badge bg-success">Yes</span>
              }
              else
              {
                <span class="badge bg-warning text-dark">No</span>
              }
            </td>
            <td>@toDoItem?.Ordering</td>
            <td>@toDoItem?.ToDoList?.Title</td>
            <td>@toDoItem?.Title</td>
            @* TableRowCodePlaceholder *@
          </tr>
        }
      }
    </tbody>
  </table>

  <!-- Pagination Controls -->
  <nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
      <!-- Previous Page Button -->
      <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
        <a class="page-link" href="@GetPaginationUrl(currentPage - 1)" aria-label="Previous">
          <span aria-hidden="true">&laquo;</span>
        </a>
      </li>

      <!-- Page Number Buttons -->
      @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
      {
        <li class="page-item @(i == currentPage ? "active" : "")">
          <a class="page-link" href="@GetPaginationUrl(i)">@i</a>
        </li>
      }

      <!-- Next Page Button -->
      <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
        <a class="page-link" href="@GetPaginationUrl(currentPage + 1)" aria-label="Next">
          <span aria-hidden="true">&raquo;</span>
        </a>
      </li>
    </ul>
  </nav>
  <div class="text-center">
    <small class="text-muted">Showing page @currentPage of @totalPages (@totalItems total items)</small>
  </div>
</div>

@code {
  private ICollection<ToDoItem>? toDoItems { get; set; }
  private int currentPage = 1;
  private string defaultSortField = "Title"; // Default sort field
  private string sortField = "Title"; // Default sort field
  private string sortDirection = "asc"; // Default sort direction

  // Default items per page
  private int pageSize = 10;
  private int totalItems = 0;
  private int totalPages = 0;

  protected override void OnInitialized()
  {
    // Subscribe to the LocationChanged event when the component is initialized
    Navigation.LocationChanged += OnLocationChanged;
  }

  // Implement IDisposable to properly unsubscribe from the event
  public void Dispose()
  {
    // Unsubscribe from the event when the component is disposed
    Navigation.LocationChanged -= OnLocationChanged;
  }

  private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
  {
    // Read the query parameters and reload data
    await ParseQueryParametersAndLoadData();
    
    // Since this is an async void method called from an event handler,
    // we need to manually trigger a UI update
    StateHasChanged();
  }

  protected override async Task OnInitializedAsync()
  {
    await ParseQueryParametersAndLoadData();
  }

  private async Task ParseQueryParametersAndLoadData()
  {
    // Parse query parameters from the current URL
    var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
    var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);

    // Get page from query parameters or default to 1
    if (int.TryParse(queryParams["page"], out int page) && page > 0)
    {
      currentPage = page;
    }
    else
    {
      currentPage = 1;
    }

    // Get sort field and direction from query parameters or use defaults
    if (!string.IsNullOrWhiteSpace(queryParams["sort"]))
    {
      sortField = queryParams["sort"];
    }
    else
    {
      sortField = defaultSortField;
    }

    if (!string.IsNullOrWhiteSpace(queryParams["dir"]) && 
        (queryParams["dir"] == "asc" || queryParams["dir"] == "desc"))
    {
      sortDirection = queryParams["dir"];
    }
    else
    {
      sortDirection = "asc";
    }

    await LoadDataAsync();
  }

  private async Task LoadDataAsync()
  {
    using var context = DbFactory.CreateDbContext();
    var query = context.ToDoItems?.AsQueryable();

    if (query is not null)
    {
      // Include related data
      query = query.Include(x => x.ToDoList);
      @* QueryIncludeCodePlaceholder *@

      // Count total items for pagination
      totalItems = await query.CountAsync();

      // Calculate total pages
      totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);

      // If current page exceeds total pages, adjust it
      if (currentPage > totalPages && totalPages > 0)
      {
        currentPage = totalPages;
        Navigation.NavigateTo(GetPaginationUrl(currentPage), replace: true);
        return;
      }

      // Apply sorting based on parameters
      query = ApplySorting(query);

      // Get paginated data
      toDoItems = await query
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .AsNoTracking()
        .ToListAsync();
    }
    else
    {
      toDoItems = new List<ToDoItem>();
    }
  }

  private IQueryable<ToDoItem> ApplySorting(IQueryable<ToDoItem> query)
  {
    return sortField switch
    {
      "IsCompleted" => sortDirection == "asc" 
                      ? query.OrderBy(x => x.IsCompleted)
                      : query.OrderByDescending(x => x.IsCompleted),
      "Ordering" => sortDirection == "asc" 
                   ? query.OrderBy(x => x.Ordering)
                   : query.OrderByDescending(x => x.Ordering),
      "ToDoListTitle" => sortDirection == "asc" 
                        ? query.OrderBy(x => x.ToDoList.Title)
                        : query.OrderByDescending(x => x.ToDoList.Title),
      "Title" => sortDirection == "asc" 
                ? query.OrderBy(x => x.Title)
                : query.OrderByDescending(x => x.Title),
      // Add more sort fields as needed
      _ => query.OrderBy(x => x.Ordering) // Default sorting
    };
  }

  private string GetSortUrl(string field)
  {
    // Toggle direction if clicking the same field, otherwise default to ascending
    string direction = field == sortField
        ? sortDirection == "asc" ? "desc" : "asc"
        : "asc";

    return $"/admin/to-do-item?page={currentPage}&sort={field}&dir={direction}";
  }

  private string GetPaginationUrl(int page)
  {
    // Build URL with current sort parameters
    return $"/admin/to-do-item?page={page}&sort={sortField}&dir={sortDirection}";
  }
}
