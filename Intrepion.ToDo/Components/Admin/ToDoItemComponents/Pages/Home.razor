@page "/admin/to-do-item"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>To Do Item Home</PageTitle>

<h1>To Do Item Home</h1>
<h6><a href="/admin/to-do-item/add">Create New</a></h6>

<div class="container-fluid">
  <table class="table table-hover table-primary table-striped">
    <thead>
      <tr>
        <th>Actions</th>
        <th>
          <div style="cursor: pointer;" @onclick="() => SortByIsCompleted()">
            Is Completed?
            @if (currentSortColumn == "IsCompleted")
            {
              <span>@(isAscending ? "↑" : "↓")</span>
            }
          </div>
        </th>
        <th>
          <div style="cursor: pointer;" @onclick="() => SortByOrdering()">
            Ordering
            @if (currentSortColumn == "Ordering")
            {
              <span>@(isAscending ? "↑" : "↓")</span>
            }
          </div>
        </th>
        <th>
          <div style="cursor: pointer;" @onclick="() => SortByToDoList()">
            To Do List
            @if (currentSortColumn == "ToDoList")
            {
              <span>@(isAscending ? "↑" : "↓")</span>
            }
          </div>
        </th>
        <th>
          <div style="cursor: pointer;" @onclick="() => SortByTitle()">
            Title
            @if (currentSortColumn == "Title")
            {
              <span>@(isAscending ? "↑" : "↓")</span>
            }
          </div>
        </th>
        @* TableHeaderCodePlaceholder *@
      </tr>
    </thead>
    <tbody>
      @if (toDoItems is not null)
      {
        @foreach (var toDoItem in toDoItems)
        {
          <tr>
            <td>
              <div class="btn-group">
                <a class="btn btn-primary btn-sm btn-info" href="/admin/to-do-item/view/@toDoItem.Id" title="View">
                  <i class="bi bi-eye"></i>
                </a>
                <a class="btn btn-primary btn-sm" href="/admin/to-do-item/edit/@toDoItem.Id" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
              </div>
            </td>
            <td>
              @if (toDoItem != null && toDoItem.IsCompleted)
              {
                <span class="badge bg-success">Yes</span>
              }
              else
              {
                <span class="badge bg-warning text-dark">No</span>
              }
            </td>
            <td>@toDoItem?.Ordering</td>
            <td>@toDoItem?.ToDoList?.Title</td>
            <td>@toDoItem?.Title</td>
            @* TableRowCodePlaceholder *@
          </tr>
        }
      }
    </tbody>
  </table>
</div>

@code {
  private ICollection<ToDoItem>? toDoItems { get; set; }
  private string currentSortColumn = "";
  private bool isAscending = true;

  protected override async Task OnParametersSetAsync()
  {
    await ReloadAsync();
  }

  private async Task ReloadAsync()
  {
    using var context = DbFactory.CreateDbContext();
    var query = context.ToDoItems?.AsQueryable();

    if (query is not null)
    {
      toDoItems = await query
        .Include(x => x.ToDoList)
        @* QueryIncludeCodePlaceholder *@
        .AsNoTracking().ToListAsync();
      
      ApplyCurrentSort();
    }
    else
    {
      toDoItems = new List<ToDoItem>();
    }
  }

  private void SortByIsCompleted()
  {
    if (currentSortColumn == "IsCompleted")
    {
      isAscending = !isAscending;
    }
    else
    {
      currentSortColumn = "IsCompleted";
      isAscending = true;
    }
    
    ApplyCurrentSort();
  }

  private void SortByOrdering()
  {
    if (currentSortColumn == "Ordering")
    {
      isAscending = !isAscending;
    }
    else
    {
      currentSortColumn = "Ordering";
      isAscending = true;
    }
    
    ApplyCurrentSort();
  }

  private void SortByToDoList()
  {
    if (currentSortColumn == "ToDoList")
    {
      isAscending = !isAscending;
    }
    else
    {
      currentSortColumn = "ToDoList";
      isAscending = true;
    }
    
    ApplyCurrentSort();
  }

  private void SortByTitle()
  {
    if (currentSortColumn == "Title")
    {
      isAscending = !isAscending;
    }
    else
    {
      currentSortColumn = "Title";
      isAscending = true;
    }
    
    ApplyCurrentSort();
  }

  private void ApplyCurrentSort()
  {
    if (toDoItems == null || !toDoItems.Any())
      return;

    switch (currentSortColumn)
    {
      case "IsCompleted":
        toDoItems = isAscending
          ? toDoItems.OrderBy(t => t.IsCompleted).ToList()
          : toDoItems.OrderByDescending(t => t.IsCompleted).ToList();
        break;

      case "Ordering":
        toDoItems = isAscending
          ? toDoItems.OrderBy(t => t.Ordering).ToList()
          : toDoItems.OrderByDescending(t => t.Ordering).ToList();
        break;

      case "ToDoList":
        toDoItems = isAscending
          ? toDoItems.OrderBy(t => t.ToDoList != null ? t.ToDoList.Title : "").ToList()
          : toDoItems.OrderByDescending(t => t.ToDoList != null ? t.ToDoList.Title : "").ToList();
        break;

      case "Title":
        toDoItems = isAscending
          ? toDoItems.OrderBy(t => t.Title ?? "").ToList()
          : toDoItems.OrderByDescending(t => t.Title ?? "").ToList();
        break;
    }
  }
}
