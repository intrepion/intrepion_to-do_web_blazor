@page "/admin/to-do-item"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>To Do Item Home</PageTitle>

<h1>To Do Item Home</h1>
<h6><a href="/admin/to-do-item/add">Create New</a></h6>

<DataTable TItem="ToDoItem" Items="toDoItems" Columns="columns" EnableSorting="true">
  <ActionTemplate Context="item">
    <div class="btn-group">
      <a class="btn btn-primary btn-sm btn-info" href="/admin/to-do-item/view/@item.Id" title="View">
        <i class="bi bi-eye"></i>
      </a>
      <a class="btn btn-primary btn-sm" href="/admin/to-do-item/edit/@item.Id" title="Edit">
        <i class="bi bi-pencil"></i>
      </a>
    </div>
  </ActionTemplate>
</DataTable>

@code {
  private ICollection<ToDoItem>? toDoItems { get; set; }
  private List<DataColumn<ToDoItem>> columns = new();

  protected override void OnInitialized()
  {
    // Define columns
    columns = new List<DataColumn<ToDoItem>>
    {
      new DataColumn<ToDoItem>
      {
        Title = "Is Completed?",
        PropertyName = "IsCompleted",
        Template = (item) => @<span class="badge @(item.IsCompleted ? "bg-success" : "bg-warning text-dark")">
                               @(item.IsCompleted ? "Yes" : "No")
                             </span>
      },
      new DataColumn<ToDoItem>
      {
        Title = "Ordering",
        PropertyName = "Ordering"
      },
      new DataColumn<ToDoItem>
      {
        Title = "To Do List",
        PropertyName = "ToDoList.Title"
      },
      new DataColumn<ToDoItem>
      {
        Title = "Title",
        PropertyName = "Title"
      }
      // Add other columns as needed
    };
  }

  protected override async Task OnParametersSetAsync()
  {
    await ReloadAsync();
  }

  private async Task ReloadAsync()
  {
    toDoItems = new List<ToDoItem>();

    using var context = DbFactory.CreateDbContext();
    var query = context.ToDoItems?.AsQueryable();

    if (query is not null)
    {
      toDoItems = await query
        .Include(x => x.ToDoList)
        // Any other includes needed
        .AsNoTracking().ToListAsync();
    }
  }
}
